{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.52.0",
    "@sveltejs/enhanced-img": "0.6.0",
    "@sveltejs/kit": "2.21.5",
    "@sveltejs/vite-plugin-svelte": "5.1.0",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/vite": "4.1.10",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.8",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.32",
    "@vitest/ui": "3.2.3",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.43",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-svelte": "3.9.2",
    "firebase-tools": "14.7.0",
    "globals": "16.2.0",
    "jest": "29.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.12",
    "svelte": "5.34.3",
    "svelte-check": "4.2.1",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.10",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vercel": "42.3.0",
    "vite": "6.3.5",
    "vitest": "3.2.3"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.5.0",
    "@sentry/sveltekit": "^9.5.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.7.2",
    "firebase": "11.9.0",
    "playwright": "^1.50.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "svelte-preprocess"
    ]
