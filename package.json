{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@playwright/test": "1.52.0",
    "@sveltejs/enhanced-img": "0.5.1",
    "@sveltejs/kit": "2.20.8",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/vite": "4.1.6",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.17",
    "@vitest/ui": "3.1.3",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.35",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-svelte": "3.5.1",
    "firebase-tools": "14.3.0",
    "globals": "16.1.0",
    "jest": "29.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "svelte": "5.28.2",
    "svelte-check": "4.1.7",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.6",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vercel": "41.7.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.5.0",
    "@sentry/sveltekit": "^9.5.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.7.2",
    "firebase": "11.7.1",
    "playwright": "^1.50.1"
