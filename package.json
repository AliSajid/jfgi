{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@playwright/test": "1.53.1",
    "@sveltejs/enhanced-img": "0.6.1",
    "@sveltejs/kit": "2.22.2",
    "@sveltejs/vite-plugin-svelte": "5.1.0",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.34",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.43",
    "eslint": "9.30.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-svelte": "3.10.1",
    "firebase-tools": "14.9.0",
    "globals": "16.2.0",
    "jest": "30.0.3",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.13",
    "svelte": "5.34.9",
    "svelte-check": "4.2.2",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.11",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vercel": "43.3.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.5.0",
    "@sentry/sveltekit": "^9.5.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.7.2",
    "firebase": "11.9.1",
    "playwright": "^1.50.1"
