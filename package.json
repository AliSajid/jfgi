{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "1.54.1",
    "@sveltejs/enhanced-img": "0.7.0",
    "@sveltejs/kit": "2.25.1",
    "@sveltejs/vite-plugin-svelte": "6.1.0",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.16.5",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.46",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.11.0",
    "firebase-tools": "14.11.0",
    "globals": "16.3.0",
    "jest": "30.0.5",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "svelte": "5.36.13",
    "svelte-check": "4.3.0",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.11",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vercel": "44.5.0",
    "vite": "7.0.5",
    "vitest": "3.2.4"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.5.0",
    "@sentry/sveltekit": "^9.5.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.8.0",
    "firebase": "12.0.0",
    "playwright": "^1.50.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "svelte-preprocess"
    ]
