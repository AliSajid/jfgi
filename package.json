{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.8.1+sha512.c50088ba998c67b8ca8c99df8a5e02fd2ae2e2b29aaf238feaa9e124248d3f48f9fb6db2424949ff901cffbb5e0f0cc1ad6aedb602cd29450751d11c35023677",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@playwright/test": "1.51.1",
    "@sveltejs/enhanced-img": "0.4.4",
    "@sveltejs/kit": "2.20.7",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@testing-library/jest-dom": "6.6.3",
    "@types/eslint__js": "9.14.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.1",
    "@vitest/ui": "3.1.1",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.19",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-svelte": "3.5.1",
    "eslint-plugin-tailwindcss": "3.18.0",
    "firebase-tools": "14.1.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "svelte": "5.27.0",
    "svelte-check": "4.1.6",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.4",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "vercel": "41.6.0",
    "vite": "6.2.6",
    "vitest": "3.1.1"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "@sentry/sveltekit": "^9.0.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.7.0",
    "firebase": "11.6.0",
    "playwright": "^1.50.1"
