{
  "name": "jfgi",
  "version": "0.9.9",
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6",
  "browserslist": [
    "> 0.5%",
    "last 10 versions",
    "node > 22",
    "not dead"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:ci": "vitest run && playwright test",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "emulate": "firebase emulators:start",
    "supported_browsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > src/lib/utils/supportedBrowsers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@playwright/test": "1.51.0",
    "@sveltejs/enhanced-img": "0.4.4",
    "@sveltejs/kit": "2.19.2",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@testing-library/svelte": "5.2.7",
    "@testing-library/jest-dom": "6.6.3",
    "@types/eslint__js": "9.14.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@vitest/ui": "3.0.8",
    "autoprefixer": "10.4.21",
    "browserslist-useragent-regexp": "4.1.3",
    "daisyui": "5.0.4",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-svelte": "3.1.0",
    "eslint-plugin-tailwindcss": "3.18.0",
    "firebase-tools": "13.34.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "jsdom": "26.0.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "svelte": "5.23.1",
    "svelte-check": "4.1.5",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.0.14",
    "tslib": "2.8.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1",
    "vercel": "41.4.1",
    "vite": "6.2.2",
    "vitest": "3.0.8"
  },
  "type": "module",
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "@sentry/sveltekit": "^9.0.0",
    "@sentry/tracing": "7.120.3",
    "@sveltejs/adapter-vercel": "5.6.3",
    "firebase": "11.4.0",
    "playwright": "^1.50.1"
  }
}
